# syntax=docker/dockerfile:1
FROM debian:13.7-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

# Build-time only, so it doesn't leak into the running container
ARG DEBIAN_FRONTEND=noninteractive

ENV ADMIN_PASSWORD=admin

# Install required packages for building
# Drop the snakeoil key pair generated by ssl-cert: CUPS doesn't use it and it
# would otherwise be shared by every container from this image
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    sudo \
    cups \
    cups-bsd \
    cups-filters \
    libcupsimage2t64 \
    foomatic-db-compressed-ppds \
    printer-driver-all \
    openprinting-ppds \
    hpijs-ppds \
    hp-ppd \
    hplip \
    && rm -f /etc/ssl/private/ssl-cert-snakeoil.key /etc/ssl/certs/ssl-cert-snakeoil.pem \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Download and install Pantum driver
# Drop the bundled ipp-usb daemon: it is only started via systemd/udev, which
# don't run here, and is built with an outdated Go toolchain
WORKDIR /tmp
RUN curl -fsSLo driver.zip -H 'Referer: https://global.pantum.com/support/download/driver/' \
    'https://drivers.pantum.com/userfiles/files/download/drive/5103/Pantum%20Linux%20Driver%20V1_1_186.zip' \
    && unzip driver.zip \
    && cd Pantum* \
    && dpkg -i Resources/pantum_1.1.186-1_amd64.deb \
    && rm -f /opt/pantum/bin/ipp-usb /lib/systemd/system/pt-ipp-usb.service \
    && cd .. \
    && rm -rf /tmp/*

# Add print user
RUN adduser --home /home/admin --shell /bin/bash --gecos "admin" --disabled-password admin \
  && adduser admin sudo \
  && adduser admin lp \
  && adduser admin lpadmin

# Disable sudo password checking
RUN echo 'admin ALL=(ALL:ALL) ALL' >> /etc/sudoers

# Enable access to CUPS
RUN /usr/sbin/cupsd \
  && while [ ! -f /var/run/cups/cupsd.pid ]; do sleep 1; done \
  && cupsctl --remote-admin --remote-any --share-printers \
  && kill $(cat /var/run/cups/cupsd.pid) \
  && echo "ServerAlias *" >> /etc/cups/cupsd.conf

# Copy /etc/cups for skeleton usage
RUN cp -rp /etc/cups /etc/cups-skel

ADD docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT [ "docker-entrypoint.sh" ]

CMD ["cupsd", "-f"]
VOLUME ["/etc/cups"]
EXPOSE 631
